    "apple_auth.error.missing_authorization_code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t complete Sign in with Apple. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Appleでサインイン」を完了できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 인증을 완료할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成「使用 Apple 登入」，請再試一次。"
          }
        }
      }
    },
