    "invite.error.backend_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check the invite code right now. Try again shortly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、招待コードを確認できません。しばらくしてから、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 초대 코드를 확인할 수 없습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法讀取邀請碼，請稍後再試。"
          }
        }
      }
    },
    "invite.error.clipboard_failed": {
      "extractionState": "manual",
      "localizations": {
