    "backend.error.authentication_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインが必要です。もう一度ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 필요합니다. 다시 로그인해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入狀態已失效，請重新登入。"
          }
        }
      }
    },
    "backend.error.current_user_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t verify your sign-in. Sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン情報を確認できませんでした。もう一度ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 정보를 확인하지 못했습니다. 다시 로그인해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認目前的帳號，請重新登入。"
          }
        }
      }
    },
    "backend.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the request. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成要求，請稍後再試。"
          }
        }
      }
    },
    "backend.error.invalid_invite_code": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the invite code and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드를 다시 확인해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認邀請碼後再試一次。"
          }
        }
      }
    },
    "backend.error.invalid_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a message with no more than 200 characters and 3 lines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは200文字・3行以内で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지는 200자·3줄 이하로 입력해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息請勿超過 200 個字元及 3 行。"
          }
        }
      }
    },
    "backend.error.invalid_profile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a nickname of 2–8 characters without line breaks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネームは改行なしの2〜8文字で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닉네임은 줄바꿈 없이 2~8자로 입력해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暱稱請輸入 2 至 8 個字元，且不要換行。"
          }
        }
      }
    },
    "backend.error.invalid_room_name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a group name of 1–20 characters without line breaks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ名は改行なしの1〜20文字で入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 이름은 줄바꿈 없이 1~20자로 입력해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組名稱請輸入 1 至 20 個字元，且不要換行。"
          }
        }
      }
    },
    "backend.error.invalid_timestamp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the message details. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ情報を読み取れませんでした。しばらくしてから、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 정보를 읽지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取訊息資訊，請稍後再試。"
          }
        }
      }
    },
    "backend.error.invite_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many invite code attempts. Try again in 10 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードの試行回数が多すぎます。10分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드 시도가 너무 많습니다. 10분 뒤 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試邀請碼的次數過多，請在 10 分鐘後再試。"
          }
        }
      }
    },
    "backend.error.malformed_response": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the request. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを完了できませんでした。しばらくしてから、もう一度お試しください。"
