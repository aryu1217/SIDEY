    "settings.display.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control how friends’ status and messages appear on screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちの状態とメッセージが画面に表示される方法を調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 상태와 메시지가 화면에 나타나는 방식을 조절할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整朋友狀態與訊息在螢幕上的顯示方式。"
          }
        }
      }
    },
    "settings.display.throw_guard.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, click a friend’s character to throw immediately. When on, double-right-click your character first, then click a friend’s character within 10 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、友だちのキャラクターを左クリックしてすぐに投げられます。オンにすると、自分のキャラクターを右ボタンでダブルクリックしてから10秒間だけ、友だちのキャラクターを左クリックして投げられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 친구 캐릭터를 왼쪽 클릭해 바로 던질 수 있습니다. 켜면 내 캐릭터를 오른쪽 두 번 클릭한 뒤 10초 동안만 친구 캐릭터를 왼쪽 클릭해 던질 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時，在朋友角色上按一下滑鼠左鍵即可直接投擲。開啟時，先在自己的角色上連按兩下滑鼠右鍵，再於 10 秒內在朋友角色上按一下滑鼠左鍵即可投擲。"
          }
        }
      }
    },
    "settings.display.throw_guard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click twice before throwing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のキャラクターを右ボタンでダブルクリックしてから投げる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 캐릭터를 오른쪽 두 번 클릭한 뒤 던지기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在自己的角色上連按兩下滑鼠右鍵再投擲"
