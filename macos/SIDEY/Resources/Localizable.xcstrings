    "backend.error.session_recovery_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t restore your previous sign-in. No new account was created. Sign in again or contact support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のログインを復元できませんでした。新しいアカウントは作成されていません。もう一度ログインするか、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 로그인을 복구하지 못했습니다. 새 계정은 만들지 않았으니 다시 로그인하거나 지원을 요청해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法還原先前的登入狀態。系統並未建立新帳號，請重新登入或聯絡支援。"
          }
        }
      }
    },
