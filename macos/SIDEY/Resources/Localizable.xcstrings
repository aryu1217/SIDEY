    "settings.display.quiet_mode.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide message bubbles and typing indicators while keeping connection status and unread counts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの吹き出しと入力中の表示を隠し、接続状態と未読数は表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 말풍선과 입력 중 표시를 숨기고 연결 상태와 읽지 않은 메시지 수는 유지합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏訊息泡泡和輸入狀態指示，同時保留連線狀態與未讀數。"
          }
        }
      }
    },
    "settings.display.quiet_mode.title": {
