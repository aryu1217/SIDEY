    "auth.apple.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple is required in the App Store version to restore purchases and protect your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内課金の復元とアカウント保護のため、App Store版ではAppleでのサインインが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입 항목 복원과 계정 보호를 위해 Apple로 로그인해야 합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了回復購買項目並保護帳號，必須使用 Apple 登入。"
          }
        }
      }
    },
    "auth.apple.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
