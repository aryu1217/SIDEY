    "groups.leave.message.last_owner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because you are the last member, the group and all messages will be permanently deleted and cannot be recovered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のメンバーのため、グループとすべてのメッセージが完全に削除され、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 멤버이므로 그룹과 모든 메시지가 영구 삭제되며 복구할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是最後一位成員，因此群組與所有訊息都會永久刪除，且無法復原。"
          }
        }
      }
    },
    "groups.leave.message.member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer be able to access the group or its existing messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループと既存のメッセージにはアクセスできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹과 기존 메시지에 더 이상 접근할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將無法再查看此群組及其既有訊息。"
          }
        }
      }
    },
    "groups.leave.message.owner_transfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ownership will transfer to the remaining member who joined first, and you will no longer be able to access the group or its existing messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残っているメンバーのうち、最初に参加した人がグループオーナーになります。このグループと既存のメッセージにはアクセスできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 멤버 중 가장 먼저 참여한 사람이 방장이 되며, 그룹과 기존 메시지에 더 이상 접근할 수 없습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群主會改由最早加入的剩餘成員擔任，而你將無法再查看此群組及其既有訊息。"
          }
        }
      }
    },
