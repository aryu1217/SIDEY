        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 만들었지만 서버 연결을 마무리하지 못했습니다. 잠시 후 다시 확인해 주세요. (%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組已建立，但尚未完成伺服器連線。請稍後再確認。（%@）"
