    "settings.account.delete.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your profile, messages, and information about the groups you joined. Purchase records may be kept separately from your account where required for accounting and fraud prevention."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、メッセージ、グループへの参加情報を削除します。購入記録は、会計および不正利用防止に必要な範囲でアカウントと分けて保持される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 메시지, 그룹 참여 정보를 삭제합니다. 구입 기록은 회계·부정 사용 방지에 필요한 범위에서 계정과 분리해 보관될 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除你的個人檔案、訊息和群組成員資格。基於會計與防止詐騙所需，購買記錄可能會與帳號分開保存。"
          }
        }
      }
    },
    "settings.account.delete.placeholder": {
      "extractionState": "manual",
      "localizations": {
