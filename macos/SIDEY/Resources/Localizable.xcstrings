    "settings.account.delete.authentication_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter “DELETE,” then sign in with Apple again to delete the account immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「削除」と入力し、Appleで再度サインインすると、アカウントはすぐに削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘탈퇴’를 입력한 뒤 Apple로 다시 로그인하면 계정이 즉시 삭제됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入「刪除」並再次使用 Apple 登入後，帳號會立即刪除。"
          }
        }
      }
    },
    "settings.account.delete.confirmation_phrase": {
      "extractionState": "manual",
      "localizations": {
