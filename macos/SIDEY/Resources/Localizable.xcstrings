{
  "sourceLanguage": "en",
  "strings": {
    "account.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t delete your account. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 삭제하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除帳號，請再試一次。"
          }
        }
      }
    },
    "account_delete.error.request_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete the account deletion request. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント削除リクエストを完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 삭제 요청을 완료하지 못했습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成刪除帳號的要求。"
          }
        }
      }
    },
