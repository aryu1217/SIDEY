    "store.footer.app_store.entitlement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app purchases are processed by the App Store. You can use an item as soon as your purchase is confirmed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内課金はApp Storeで処理されます。購入が確認されると、すぐに利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 내 구입은 App Store에서 처리합니다. 구입이 확인되면 바로 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內購買由 App Store 處理。確認購買後即可立即使用。"
          }
        }
      }
    },
    "store.footer.app_store.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are shown and purchases are processed by the App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格の表示と支払い処理はApp Storeで行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격은 App Store에서 표시하며 구입도 App Store에서 처리합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
