        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得最新資料，請稍後再試。"
          }
        }
      }
    },
    "backend.error.member_limit_reached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This group is already full with %lld member."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This group is already full with %lld members."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このグループはすでに%lld人で満員です。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このグループはすでに%lld人で満員です。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이 그룹은 이미 %lld명으로 가득 찼습니다."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "이 그룹은 이미 %lld명으로 가득 찼습니다."
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "這個群組已有 %lld 位成員，名額已滿。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "這個群組已有 %lld 位成員，名額已滿。"
                }
              }
            }
          }
        }
      }
    },
    "backend.error.member_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t find the member to remove."
          }
        },
        "ja": {
