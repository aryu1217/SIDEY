    "backend.connect.failed_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect to the server. Check your internet connection and try again. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。インターネット接続を確認して、もう一度お試しください。（%@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 연결할 수 없습니다. 인터넷 연결을 확인한 후 다시 시도해 주세요. (%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線至伺服器。請檢查網路連線後再試一次。（%@）"
          }
        }
      }
    },
