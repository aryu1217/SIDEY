    "invite.error.not_stored_on_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invite code isn’t stored on this device. Create a new code or ask the owner for one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに招待コードが保存されていません。新しいコードを発行するか、オーナーに確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 초대 코드가 저장되어 있지 않습니다. 새 코드를 발급하거나 방장에게 요청해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置未儲存邀請碼。請產生新邀請碼或向群主索取。"
          }
        }
      }
    },
