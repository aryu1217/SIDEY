    "store.footer.direct.entitlement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displayed prices include tax. You can use customization items as soon as payment is confirmed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示価格は税込みです。支払いの確認後、カスタマイズ商品をすぐに利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 가격은 부가세 포함입니다. 결제가 확인되면 꾸미기 상품을 바로 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示價格含稅。確認購買後，即可使用數位自訂商品。"
          }
        }
      }
    },
    "store.footer.direct.refund": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-of-mind refunds aren’t available after access begins. Full refunds are provided where legally required, including non-delivery, mismatch, duplicate, or unauthorized payment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供開始後の自己都合による返金はできません。未提供、契約不一致、重複・不正決済など法定事由には全額返金します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공 시작 뒤 단순 변심 환불은 불가하며, 미제공·계약 불일치·중복·무단 결제 등 법정 사유는 전액 환불합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始提供後，不接受因改變心意而退款；未提供、與合約不符、重複或未授權付款等法定情況可全額退款。"
          }
        }
      }
    },
    "store.kind.bubble": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
