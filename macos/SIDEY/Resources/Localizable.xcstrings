          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t copy the invite code. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードをクリップボードにコピーできませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
