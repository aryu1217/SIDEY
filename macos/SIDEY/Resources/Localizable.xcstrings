          }
        }
      }
    },
    "store.footer.coming_soon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store is coming soon. Keep using items you already own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアは準備中です。所有済みの商品は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 상점은 준비 중입니다. 보유 상품은 계속 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
