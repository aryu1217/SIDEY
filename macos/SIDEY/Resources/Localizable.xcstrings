            "state": "translated",
            "value": "Leave the “%@” group?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」グループから退出しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
