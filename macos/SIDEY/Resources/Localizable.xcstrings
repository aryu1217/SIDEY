    "group.create.keychain_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group was created, but the invite code couldn’t be saved to Keychain. Save the code shown now somewhere safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは作成されましたが、招待コードをキーチェーンに保存できませんでした。現在表示されているコードを別の安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹은 생성됐지만 초대 코드를 키체인에 저장하지 못했습니다. 지금 표시된 코드를 따로 보관해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組已建立，但無法將邀請碼儲存至鑰匙圈。請另外妥善保存目前顯示的邀請碼。"
          }
        }
      }
    },
    "group.create.realtime_grant_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The group was created, but the server connection couldn’t be completed. Check again shortly. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループは作成されましたが、接続を完了できませんでした。しばらくしてから、もう一度ご確認ください。（%@）"
