<Project>
  <Import Project="$(MSBuildThisFileDirectory)Version.props" />
  <PropertyGroup>
    <SideyArchitecture Condition="'$(RuntimeIdentifier)' == 'win-arm64' or '$(Platform)' == 'ARM64'">arm64</SideyArchitecture>
    <SideyArchitecture Condition="'$(SideyArchitecture)' == ''">x64</SideyArchitecture>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin\$(SideyArchitecture)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj\$(SideyArchitecture)\</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <SideyDevelopmentCommerce Condition="'$(SideyDevelopmentCommerce)' == ''">false</SideyDevelopmentCommerce>
    <DefineConstants Condition="'$(Configuration)' == 'Debug' and '$(SideyDevelopmentCommerce)' == 'true'">$(DefineConstants);SIDEY_DEVELOPMENT_COMMERCE</DefineConstants>
  </PropertyGroup>
  <!-- The SDK may remove the RID when building library references. Keep their
       processor target and intermediate files aligned with the calling app. -->
  <ItemDefinitionGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64' and '$(Platform)' != 'ARM64'">
    <ProjectReference>
      <AdditionalProperties>SideyArchitecture=$(SideyArchitecture)</AdditionalProperties>
    </ProjectReference>
  </ItemDefinitionGroup>
  <Target Name="ValidateSideyVersionMetadata" BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec
        Command="python -X utf8 scripts/sidey_version.py --check windows"
        WorkingDirectory="$(MSBuildThisFileDirectory).." />
  </Target>
  <Target Name="RejectDevelopmentCommerceOutsideDebug" BeforeTargets="BeforeBuild"
          Condition="'$(SideyDevelopmentCommerce)' == 'true' and '$(Configuration)' != 'Debug'">
    <Error Text="SideyDevelopmentCommerce can only be compiled in Debug builds." />
  </Target>
</Project>
