<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Sidey.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(SideyArchitecture)</PlatformTarget>
    <RuntimeIdentifier>win-$(SideyArchitecture)</RuntimeIdentifier>
    <SideyDotNetRuntimeVersion>10.0.12</SideyDotNetRuntimeVersion>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>bg-BG;cs-CZ;de-DE;en-US;es-ES;fr-FR;he-IL;it-IT;ja-JP;ko-KR;nl-BE;nl-NL;pl-PL;pt-BR;pt-PT;ro-RO;ru-RU;sr-Cyrl-RS;sr-Latn-RS;tr-TR;uk-UA;zh-CN;zh-TW</SatelliteResourceLanguages>
    <AssemblyName>SIDEY.Host</AssemblyName>
    <AssemblyTitle>SIDEY</AssemblyTitle>
    <Product>SIDEY</Product>
    <ApplicationIcon>Assets\Icons\SideyAppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Services\DevelopmentUpdateService.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sidey.Core/Sidey.Core.csproj" />
    <ProjectReference Include="../Sidey.Infrastructure/Sidey.Infrastructure.csproj" />
    <ProjectReference Include="../Sidey.Overlay/Sidey.Overlay.csproj" />
    <ProjectReference Include="../Sidey.Presentation/Sidey.Presentation.csproj" />
    <ProjectReference Include="../Sidey.Platform.Windows/Sidey.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Langs\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="InternalLangs\*.json" Condition="'$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets\Icons\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Assets/Impacts/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <_SideyExternalIconAsset Include="Assets\Icons\*" />
    <_SideyExternalCharacterAsset Include="../Sidey.Overlay/Assets/Characters/**/*" />
    <_SideyExternalThrowableAsset Include="../Sidey.Overlay/Assets/Throwables/**/*" />
    <_SideyExternalBubbleAsset Include="../Sidey.Overlay/Assets/Bubbles/**/*" />
    <None Include="@(_SideyExternalCharacterAsset)" Link="Assets/Characters/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="@(_SideyExternalThrowableAsset)" Link="Assets/Throwables/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="@(_SideyExternalBubbleAsset)" Link="Assets/Bubbles/%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyExternalCharacterAssetsAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="@(_SideyExternalCharacterAsset->'$(PublishDir)Assets\Characters\%(RecursiveDir)')" />
    <Copy
        SourceFiles="@(_SideyExternalCharacterAsset)"
        DestinationFiles="@(_SideyExternalCharacterAsset->'$(PublishDir)Assets\Characters\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyExternalThrowableAssetsAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="@(_SideyExternalThrowableAsset->'$(PublishDir)Assets\Throwables\%(RecursiveDir)')" />
    <Copy
        SourceFiles="@(_SideyExternalThrowableAsset)"
        DestinationFiles="@(_SideyExternalThrowableAsset->'$(PublishDir)Assets\Throwables\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyExternalBubbleAssetsAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="@(_SideyExternalBubbleAsset->'$(PublishDir)Assets\Bubbles\%(RecursiveDir)')" />
    <Copy
        SourceFiles="@(_SideyExternalBubbleAsset)"
        DestinationFiles="@(_SideyExternalBubbleAsset->'$(PublishDir)Assets\Bubbles\%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopySideyAppIconsAfterPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Assets\Icons" />
    <Copy
        SourceFiles="@(_SideyExternalIconAsset)"
        DestinationFiles="@(_SideyExternalIconAsset->'$(PublishDir)Assets\Icons\%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
  </Target>
  <Target
      Name="OrganizeStructuredPublish"
      AfterTargets="Publish"
      DependsOnTargets="CopyExternalCharacterAssetsAfterPublish;CopyExternalThrowableAssetsAfterPublish;CopyExternalBubbleAssetsAfterPublish;CopySideyAppIconsAfterPublish">
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\..\scripts\windows\ConvertTo-PublishLayout.ps1&quot; -PublishDirectory &quot;$(PublishDir).&quot; -LauncherSourcePath &quot;$(MSBuildProjectDirectory)\..\Sidey.Launcher\Program.cs&quot; -UninstallerSourcePath &quot;$(MSBuildProjectDirectory)\..\Sidey.Uninstaller\Program.cs&quot; -Version &quot;$(Version)&quot; -FileVersion &quot;$(FileVersion)&quot;" />
  </Target>
</Project>
