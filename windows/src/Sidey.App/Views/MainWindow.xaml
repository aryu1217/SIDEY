              <StackPanel x:Name="UpdateSection" Margin="0,12,0,0" Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.update.title}, Mode=OneWay}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=settings.update.description}, Mode=OneWay}" />
                </StackPanel>
                <Border Padding="0" Style="{StaticResource SideySettingsCardStyle}">
                  <StackPanel>
                    <Grid x:Name="UpdateSectionHeader" Padding="20,16" ColumnSpacing="16" Background="Transparent"
                        PointerEntered="OnUpdateSectionHeaderPointerEntered"
                        PointerExited="OnUpdateSectionHeaderPointerExited"
                        Tapped="OnUpdateSectionHeaderTapped">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Border x:Name="UpdateSectionHeaderHoverBackground" Grid.ColumnSpan="4" Margin="-20,-16"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8,8,0,0"
                          IsHitTestVisible="False" Opacity="0" />
                      <FontIcon FontSize="22" Glyph="&#xE895;" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{StaticResource SideySettingsRowTitleStyle}" Text="{Binding CurrentVersionText}" />
                        <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding AvailableVersionText}" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid>
                          <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding LastUpdateCheckText}" Visibility="{Binding HasUpdateActivity, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                          <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding HasUpdateActivity, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressRing Width="16" Height="16" IsActive="{Binding HasUpdateActivity}" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding UpdateActivityText}" />
                          </StackPanel>
                        </Grid>
                        <HyperlinkButton HorizontalAlignment="Left" Style="{StaticResource SideySettingsDescriptionLinkStyle}" Command="{Binding OpenReleaseNotesCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.update.release_notes.action}, Mode=OneWay}" />
                      </StackPanel>
                      <Button Grid.Column="2" Command="{Binding CheckForUpdatesCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.update.check.action}, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=settings.update.check_now.tooltip}, Mode=OneWay}" />
                      <ToggleButton x:Name="UpdateSectionToggle" Grid.Column="3" IsChecked="True" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="UpdateSectionToggle"
                          AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=settings.update.title}, Mode=OneWay}"
                          Click="OnUpdateSectionToggleClick" Style="{StaticResource SideyUpdateSectionToggleStyle}">
                        <FontIcon x:Name="UpdateSectionChevron" FontSize="12" Glyph="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                          <FontIcon.RenderTransform><RotateTransform Angle="180" /></FontIcon.RenderTransform>
                        </FontIcon>
                      </ToggleButton>
                    </Grid>
                    <StackPanel x:Name="UpdateSectionDetails">
                      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,14" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid ColumnSpacing="16">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <TextBlock VerticalAlignment="Center" Text="{Binding Value, Source={i18n:I18n Key=settings.update.available_action.description}, Mode=OneWay}" TextWrapping="Wrap" />
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding DownloadUpdateCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.update.download.action}, Mode=OneWay}" Visibility="{Binding IsUpdateReady, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <Button Command="{Binding InstallUpdateCommand}" Content="{Binding Value, Source={i18n:I18n Key=settings.update.install.action}, Mode=OneWay}" Visibility="{Binding IsUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <CheckBox IsChecked="{Binding AutoInstallUpdates, Mode=TwoWay}">
                          <StackPanel>
                            <TextBlock Text="{Binding Value, Source={i18n:I18n Key=settings.update.auto_install.title}, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding Value, Source={i18n:I18n Key=settings.update.auto_install.metered_exclusion}, Mode=OneWay}" />
                          </StackPanel>
                        </CheckBox>
                      </Border>
                      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <CheckBox Content="{Binding Value, Source={i18n:I18n Key=settings.update.notify.title}, Mode=OneWay}" IsChecked="{Binding NotifyWhenUpdateAvailable, Mode=TwoWay}" />
                      </Border>
                      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                        <CheckBox Content="{Binding Value, Source={i18n:I18n Key=settings.update.show_after.title}, Mode=OneWay}" IsChecked="{Binding ShowReleaseNotesAfterUpdate, Mode=TwoWay}" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon FontSize="22" Glyph="&#xE939;" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SideySettingsRowTitleStyle}" Text="{Binding Value, Source={i18n:I18n Key=support.feedback.title}, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding Value, Source={i18n:I18n Key=support.feedback.description}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://github.com/sidey-app/SIDEY/issues/new/choose" Content="{Binding Value, Source={i18n:I18n Key=support.feedback.action}, Mode=OneWay}" />
                </Grid>
              </Border>

              <Border Style="{StaticResource SideySettingsCardStyle}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <FontIcon FontSize="22" Glyph="&#xE90F;" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SideySettingsRowTitleStyle}" Text="{Binding Value, Source={i18n:I18n Key=support.diagnostics.title}, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding Value, Source={i18n:I18n Key=support.diagnostics.description}, Mode=OneWay}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding ExportDiagnosticDataCommand}" Content="{Binding Value, Source={i18n:I18n Key=support.diagnostics.export.action}, Mode=OneWay}" />
                </Grid>
              </Border>

              <StackPanel Margin="0,12,0,0" Spacing="8">
                <StackPanel Spacing="4">
                  <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=account.title}, Mode=OneWay}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=account.description}, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource SideySettingsCardStyle}" Padding="8">
                  <Grid Padding="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon FontSize="22" Glyph="&#xE748;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource SideySettingsRowTitleStyle}" Text="{Binding Value, Source={i18n:I18n Key=account.sign_out.title}, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding Value, Source={i18n:I18n Key=account.sign_out.description}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding SignOutCommand}" Content="{Binding Value, Source={i18n:I18n Key=account.sign_out.title}, Mode=OneWay}" />
                  </Grid>
                </Border>
                <Border Style="{StaticResource SideySettingsCardStyle}" Padding="8">
                  <Grid Padding="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon FontSize="22" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource SideySettingsRowTitleStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding Value, Source={i18n:I18n Key=account.delete.title}, Mode=OneWay}" />
                      <TextBlock Style="{StaticResource SideySettingsRowDescriptionStyle}" Text="{Binding Value, Source={i18n:I18n Key=account.delete.description}, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding DeleteAccountCommand}">
                      <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{Binding Value, Source={i18n:I18n Key=account.delete.confirmation.action}, Mode=OneWay}" />
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Margin="0,12,0,0" Spacing="8">
                <StackPanel Spacing="4">
                  <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=legal.title}, Mode=OneWay}" />
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=legal.description}, Mode=OneWay}" />
                </StackPanel>
                <Border Style="{StaticResource SideySettingsCardStyle}" Padding="8">
                  <StackPanel Spacing="0">
                    <Button Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://sidey-app.github.io/SIDEY/terms/">
                      <Grid><TextBlock Text="{Binding Value, Source={i18n:I18n Key=legal.terms.action}, Mode=OneWay}" /><FontIcon HorizontalAlignment="Right" Glyph="&#xE8A7;" /></Grid>
                    </Button>
                    <Rectangle Height="1" Margin="12,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://sidey-app.github.io/SIDEY/privacy/">
                      <Grid><TextBlock Text="{Binding Value, Source={i18n:I18n Key=legal.privacy.action}, Mode=OneWay}" /><FontIcon HorizontalAlignment="Right" Glyph="&#xE8A7;" /></Grid>
                    </Button>
                    <Rectangle Height="1" Margin="12,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button Padding="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}" Command="{Binding OpenExternalLinkCommand}" CommandParameter="https://sidey-app.github.io/SIDEY/refund/">
                      <Grid><TextBlock Text="{Binding Value, Source={i18n:I18n Key=legal.refund.action}, Mode=OneWay}" /><FontIcon HorizontalAlignment="Right" Glyph="&#xE8A7;" /></Grid>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Margin="20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SideyInAppNoticeBackgroundBrush}"
            IsClosable="True"
            IsOpen="False" />
      </Grid>
    </NavigationView>
  </Grid>
  </UserControl>
</Window>
