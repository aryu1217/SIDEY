<Window
    x:Class="Sidey.App.Views.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sidey.App.Controls"
    xmlns:i18n="using:Sidey.App.Localization">
    <Grid x:Name="HistoryRoot" Padding="20" RowSpacing="16" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="HistoryFallbackBackground" Grid.RowSpan="3" Margin="-20" Canvas.ZIndex="-1"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />

      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="4">
          <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Title}" />
          <TextBlock
              Text="{Binding Value, Source={i18n:I18n Key=history.retention.notice}, Mode=OneWay}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              TextWrapping="Wrap" />
        </StackPanel>
        <ToggleButton x:Name="KeepOnTopButton" Grid.Column="1" Width="40" Height="40"
            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            VerticalAlignment="Top" Click="OnKeepOnTopClick"
            ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=history.window.always_on_top.enable_shortcut}, Mode=OneWay}"
            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=history.window.always_on_top.enable_shortcut}, Mode=OneWay}">
          <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="KeepOnTopIconStates">
                <VisualState x:Name="Unpinned" />
                <VisualState x:Name="Pinned">
                  <VisualState.StateTriggers>
                    <StateTrigger IsActive="{Binding IsChecked, ElementName=KeepOnTopButton}" />
                  </VisualState.StateTriggers>
                  <VisualState.Setters>
                    <Setter Target="KeepOnTopOutline.Stroke" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Target="KeepOnTopFill.Fill" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Target="KeepOnTopStem.Stroke" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Canvas.RenderTransform>
              <RotateTransform Angle="45" />
            </Canvas.RenderTransform>
            <Path x:Name="KeepOnTopOutline" Data="M7,3 L17,3 L16,7 L18,10 L18,12 L6,12 L6,10 L8,7 Z"
                Fill="Transparent" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" />
            <Path x:Name="KeepOnTopFill" Data="M7,3 L17,3 L16,7 L18,10 L18,12 L6,12 L6,10 L8,7 Z"
                Fill="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
            <Path x:Name="KeepOnTopStem" Data="M12,12 L12,22" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" />
          </Canvas>
        </ToggleButton>
      </Grid>

    <Grid Grid.Row="1">
      <ListView
          x:Name="HistoryList"
          ContainerContentChanging="OnHistoryContainerContentChanging"
          Loaded="OnHistoryListLoaded"
          SizeChanged="OnHistoryListSizeChanged"
          IsItemClickEnabled="False"
          ItemsSource="{Binding Items}"
          SelectionMode="None">
        <ListView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" />
          </ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{ThemeResource SideyAccentBackground10Brush}" CornerRadius="12">
                  <Border Width="24" Height="24">
                    <controls:PixelCharacterPreview CharacterId="{Binding CharacterId}" />
                  </Border>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{Binding SenderName}" />
                    <Border
                        Grid.Column="1"
                        Padding="6,2"
                        Background="{ThemeResource SideyAccentBackground12Brush}"
                        CornerRadius="8"
                        Visibility="{Binding IsCurrentUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SideyAccentForegroundBrush}" Text="{Binding Value, Source={i18n:I18n Key=common.me}, Mode=OneWay}" />
                    </Border>
                    <TextBlock
                        Grid.Column="3"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding LocalTimeText}" />
                  </Grid>
                  <TextBlock IsTextSelectionEnabled="True" Text="{Binding Body}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.Header>
          <Grid MinHeight="42">
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{Binding IsLoadingMore, Converter={StaticResource BooleanToVisibilityConverter}}">
              <ProgressRing Width="18" Height="18" IsActive="True" />
              <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=history.load_more.loading}, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="4"
                Visibility="{Binding IsLoadMoreFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value, Source={i18n:I18n Key=history.load_more.failed}, Mode=OneWay}" />
              <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding LoadMoreErrorMessage}" TextWrapping="Wrap" />
              <Button HorizontalAlignment="Center" Command="{Binding RetryLoadMoreCommand}" Content="{Binding Value, Source={i18n:I18n Key=history.load.retry}, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding Value, Source={i18n:I18n Key=history.pagination.exhausted}, Mode=OneWay}"
                Visibility="{Binding IsExhaustedVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </ListView.Header>
      </ListView>

      <Button x:Name="ScrollToLatestButton" Width="44" Height="44" Margin="0,0,16,16"
          HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="22"
          Visibility="Collapsed" Click="OnScrollToLatestClick"
          ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=history.scroll.latest}, Mode=OneWay}"
          AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=history.scroll.latest}, Mode=OneWay}">
        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" FontSize="20" />
      </Button>

      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{Binding IsInitialLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ProgressRing Width="28" Height="28" IsActive="True" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Value, Source={i18n:I18n Key=history.loading}, Mode=OneWay}" />
      </StackPanel>
      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{Binding IsInitialFailureVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <FontIcon HorizontalAlignment="Center" FontSize="34" Glyph="&#xE814;" />
        <TextBlock HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="{Binding Value, Source={i18n:I18n Key=history.load.initial_failed}, Mode=OneWay}" />
        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding InitialErrorMessage}" TextAlignment="Center" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Center" Command="{Binding RetryInitialCommand}" Content="{Binding Value, Source={i18n:I18n Key=history.load.retry}, Mode=OneWay}" />
      </StackPanel>
      <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <FontIcon
            HorizontalAlignment="Center"
            FontSize="34"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Glyph="&#xE8BD;" />
        <TextBlock
            HorizontalAlignment="Center"
            Style="{ThemeResource SubtitleTextBlockStyle}"
            Text="{Binding EmptyMessage}" />
        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{Binding EmptyDescription}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8" DataContext="{Binding Composer}">
      <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Visibility="{Binding IsConnectionRecovering, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
          Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="HistoryInput" Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding CanCompose}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="104"
            PlaceholderText="{Binding Value, Source={i18n:I18n Key=composer.message.placeholder}, Mode=OneWay}"
            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=composer.message.placeholder}, Mode=OneWay}"
            PreviewKeyDown="OnMessageInputPreviewKeyDown" LostFocus="OnMessageInputLostFocus" />
        <Button Grid.Column="1" Command="{Binding SendCommand}" VerticalAlignment="Bottom"
            ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=message.send.accessibility}, Mode=OneWay}"
            AutomationProperties.Name="{Binding Value, Source={i18n:I18n Key=message.send.accessibility}, Mode=OneWay}">
          <SymbolIcon Symbol="Send" />
        </Button>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
