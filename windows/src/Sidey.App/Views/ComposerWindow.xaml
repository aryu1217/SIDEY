<Window
    x:Class="Sidey.App.Views.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i18n="using:Sidey.App.Localization">
  <Grid
      x:Name="ComposerRoot"
      Width="400"
      Height="56"
      Background="{ThemeResource SideyComposerBackgroundBrush}">
    <Border
        Padding="14,10"
        Background="Transparent">
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="DragGrip"
            Background="Transparent"
            PointerEntered="OnDragGripPointerEntered"
            PointerExited="OnDragGripPointerExited"
            PointerPressed="OnDragGripPointerPressed"
            PointerMoved="OnDragGripPointerMoved"
            PointerReleased="OnDragGripPointerReleased"
            PointerCanceled="OnDragGripPointerCanceled"
            PointerCaptureLost="OnDragGripPointerCanceled"
            ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=composer.drag.tooltip}, Mode=OneWay}">
          <Canvas Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse Width="2" Height="2" Canvas.Left="0" Canvas.Top="0" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="5" Canvas.Top="0" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="10" Canvas.Top="0" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="0" Canvas.Top="5" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="5" Canvas.Top="5" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="10" Canvas.Top="5" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="0" Canvas.Top="10" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="5" Canvas.Top="10" Fill="#888888" />
            <Ellipse Width="2" Height="2" Canvas.Left="10" Canvas.Top="10" Fill="#888888" />
          </Canvas>
        </Border>

        <TextBox
            x:Name="MessageInput"
            Grid.Column="1"
            Height="34"
            Padding="10,6,10,0"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            IsEnabled="{Binding CanCompose}"
            PlaceholderText="{Binding Value, Source={i18n:I18n Key=composer.message.placeholder}, Mode=OneWay}"
            PreviewKeyDown="OnMessageInputPreviewKeyDown"
            Text="{Binding Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center">
          <TextBox.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
          </TextBox.Resources>
        </TextBox>

        <Button
            x:Name="SendButton"
            Grid.Column="2"
            Width="28"
            Height="34"
            Padding="0"
            AllowFocusOnInteraction="False"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding SendCommand}"
            IsTabStop="False"
            ToolTipService.ToolTip="{Binding Value, Source={i18n:I18n Key=message.send.accessibility}, Mode=OneWay}">
          <SymbolIcon Symbol="Send" />
        </Button>

        <ProgressRing
            Grid.Column="2"
            Width="14"
            Height="14"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsActive="{Binding IsConnectionRecovering}"
            ToolTipService.ToolTip="{Binding ConnectionMessage}"
            AutomationProperties.Name="{Binding ConnectionMessage}"
            Visibility="{Binding IsConnectionRecovering, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border
            Grid.Column="2"
            Width="14"
            Height="14"
            Margin="0,-4,-5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="{Binding ErrorMessage}"
            Background="{ThemeResource SystemFillColorCriticalBrush}"
            CornerRadius="7"
            ToolTipService.ToolTip="{Binding ErrorMessage}"
            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock
              HorizontalAlignment="Center"
              FontSize="11"
              FontWeight="Bold"
              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
              Text="!" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
