---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFonts from "../components/SiteFonts.astro";
import SiteTheme from "../components/SiteTheme.astro";
import "../styles/styles.scss";
import { supportedLocales, localeRoot, type Locale } from "../i18n/landing";
import { appStoreURLForLocale } from "../data/releases";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  ogAlt: string;
}

const { locale, title, description, ogTitle, ogDescription, ogAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalPath = localeRoot(locale);
const ogLocales = Object.fromEntries(supportedLocales.map(code => {
  const language = new Intl.Locale(code).maximize();
  return [code, `${language.language}_${language.region}`];
}));
const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL(`${base}assets/og.png`, Astro.site);
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "SIDEY",
  applicationCategory: "CommunicationApplication",
  operatingSystem: "macOS 26 or later",
  inLanguage: locale,
  url: canonical.href,
  downloadUrl: appStoreURLForLocale(locale),
  description,
};
---

<!doctype html>
<html lang={locale} dir={locale === "he" ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SiteTheme />
    <SiteFonts />
    <link rel="canonical" href={canonical}>
    {supportedLocales.map(code => <link rel="alternate" hreflang={code} href={new URL(localeRoot(code), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)}>
    <link rel="icon" type="image/png" href={`${base}assets/app-icon.png`}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="SIDEY">
    <meta property="og:locale" content={ogLocales[locale]}>
    {Object.entries(ogLocales).filter(([code]) => code !== locale).map(([, value]) => <meta property="og:locale:alternate" content={value}>)}
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={ogAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={ogDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogAlt}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script src={`${base}assets/script.js`} defer is:inline></script>
  </head>
  <body class="landing-page route-content-enter">
    <slot name="skip" />
    <SiteHeader locale={locale} current="home" />
    <slot />
  </body>
</html>
