---
import SiteFonts from "../components/SiteFonts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import LandingFooter from "../components/LandingFooter.astro";
import SiteTheme from "../components/SiteTheme.astro";
import { getTranslations, localizeCanonicalPath, supportedLocales, type Locale } from "../i18n/landing";
import "../styles/styles.scss";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  heading: string;
  introduction: string;
  locale?: Locale;
  originalPath?: string;
  translationNotice?: string;
  originalLabel?: string;
  current?: "support";
}

const { title, description, canonicalPath, heading, introduction, locale = "ko", originalPath, translationNotice, originalLabel, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(`${base}${canonicalPath}`, Astro.site);
const localePaths = supportedLocales.map((code) => ({
  code,
  path: localizeCanonicalPath(canonicalPath, code),
}));
const neutralPath = canonicalPath.replace(/^[^/]+\//, "");
const skipLabel = getTranslations(locale).skip;
---

<!doctype html>
<html lang={locale} dir={locale === "he" ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <SiteTheme />
    <SiteFonts />
    <link rel="canonical" href={canonical}>
    {localePaths.map(({ code, path }) => <link rel="alternate" hreflang={code} href={new URL(`${base}${path}`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(`${base}${neutralPath}`, Astro.site)}>
    <link rel="icon" type="image/png" href={`${base}assets/app-icon.png`}>
  </head>
  <body class="policy-page route-content-enter">
    <a class="skip-link" href="#main">{skipLabel}</a>
    <SiteHeader locale={locale} current={current} />
    <main id="main" class="policy-document">
      {translationNotice && originalPath && originalLabel && (
        <aside class="translation-notice">
          <span>{translationNotice}</span>
          <a href={`${base}${originalPath}`} lang="ko" hreflang="ko">{originalLabel}</a>
        </aside>
      )}
      <header class="policy-heading">
        <h1>{heading}</h1>
        <p>{introduction}</p>
      </header>
      <slot />
    </main>
    <LandingFooter locale={locale} />
  </body>
</html>
