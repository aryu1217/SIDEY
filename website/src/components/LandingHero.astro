---
import type { Locale } from "../i18n/landing";
import { getLandingCopy } from "../i18n/landing";
import { releases, appStoreURLForLocale } from "../data/releases";
import DownloadLegalNotice from "./DownloadLegalNotice.astro";
import PhraseText from "./PhraseText.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getLandingCopy(locale).hero;
const titleParts = "titleParts" in copy ? copy.titleParts : null;
const base = import.meta.env.BASE_URL;
const appStoreURL = appStoreURLForLocale(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">{titleParts ? <PhraseText parts={titleParts} /> : copy.title}</h1>
    <p>{copy.description}</p>
    <div class="hero-actions" aria-label={copy.downloadsLabel}>
      <div class="download-selector" data-download-selector>
        <a class="button download-button download-button-simple primary-download-action" id="primary-download-action" href={appStoreURL} data-app-store-link data-auto-download data-macos-url={appStoreURL} data-windows-url={releases.windows.url} data-windows-arm64-url="" data-macos-label={copy.appStoreDownload} data-windows-label={`${copy.windowsDownload} (x64)`} data-windows-arm64-label={`${copy.windowsDownload} (ARM64)`} data-choose-label={copy.choosePlatform} aria-describedby="hero-download-license">
          <img class="download-platform-logo download-platform-logo-macos" data-download-logo src={`${base}assets/platforms/macos-light.svg`} data-macos-logo={`${base}assets/platforms/macos-light.svg`} data-windows-logo={`${base}assets/platforms/windows-light.svg`} alt="" width="18" height="18">
          <span class="download-button-label" data-download-label>{copy.appStoreDownload}</span>
        </a>
        <button class="download-selector-toggle" type="button" data-download-toggle aria-expanded="false" aria-controls="hero-platform-menu" aria-label={copy.menuToggle} aria-describedby="hero-download-license">
          <span class="download-chevron" aria-hidden="true">
            <span class="material-symbols-rounded download-chevron-closed">expand_more</span>
            <span class="material-symbols-rounded download-chevron-open">expand_less</span>
          </span>
        </button>
        <div class="download-platform-menu" id="hero-platform-menu" data-download-menu hidden aria-label={copy.platformMenu}>
          <a href={appStoreURL} data-app-store-link><img class="download-platform-logo download-platform-logo-macos" src={`${base}assets/platforms/macos-light.svg`} alt="" width="18" height="18"><span>{copy.appStoreDownload}</span></a>
          <a id="hero-windows-x64-download-action" href={releases.windows.url} data-windows-architecture="x64"><img class="download-platform-logo download-platform-logo-windows" src={`${base}assets/platforms/windows-light.svg`} alt="" width="18" height="18"><span>{copy.windowsDownload} (x64)</span></a>
          <a id="hero-windows-arm64-download-action" href="#download" data-windows-architecture="arm64" data-windows-arm64-download hidden><img class="download-platform-logo download-platform-logo-windows" src={`${base}assets/platforms/windows-light.svg`} alt="" width="18" height="18"><span>{copy.windowsDownload} (ARM64)</span></a>
        </div>
        <DownloadLegalNotice id="hero-download-license" locale={locale} />
      </div>
    </div>
  </div>

  <figure class="hero-visual">
    <div class="monitor-scene" aria-hidden="true">
      <div class="monitor-screen">
        <span class="monitor-camera"></span>
        <div class="browser-window" data-hero-track>
          <div class="browser-toolbar"><span class="window-controls"><i class="window-close"></i><i class="window-minimize"></i><i class="window-maximize"></i></span><span class="browser-title">{copy.browserTitle}</span></div>
          <div class="browser-body">
            <span class="browser-note">{copy.browserNote}</span>
            <span class="browser-line browser-line-long"></span>
            <span class="browser-line"></span>
            <span class="browser-line browser-line-short"></span>
          </div>
          <span class="hero-actor hero-moving-actor" data-hero-motion data-start="0.15" data-direction="1">
            <span class="speech-bubble">{copy.message}</span>
            <span class="character-nameplate"><i class="presence-dot is-online"></i><strong>{copy.names.kong}</strong></span>
            <span class="character character-hamster character-state-walk"></span>
          </span>
          <span class="hero-actor hero-actor-cat" data-hero-obstacle>
            <span class="character-nameplate"><i class="presence-dot is-away"></i><strong>{copy.names.bori}</strong></span>
            <span class="sleep-mark">Zzz</span>
            <span class="character character-cat character-state-doze"></span>
          </span>
          <span class="hero-actor hero-actor-puppy" data-hero-obstacle>
            <span class="character-nameplate"><i class="presence-dot is-offline"></i><strong>{copy.names.mongsil}</strong></span>
            <span class="character character-puppy character-state-offline"></span>
          </span>
          <span class="hero-actor hero-actor-rabbit hero-moving-actor" data-hero-motion data-start="1" data-direction="-1">
            <span class="speech-bubble typing-bubble" role="status" aria-label={copy.typingLabel}><span aria-hidden="true"></span></span>
            <span class="character-nameplate"><i class="presence-dot is-online"></i><strong>{copy.names.tori}</strong></span>
            <span class="character character-rabbit character-state-walk"></span>
          </span>
          <span class="scene-edge"></span>
        </div>
      </div>
      <span class="monitor-neck"></span>
      <span class="monitor-base"></span>
    </div>
    <figcaption class="visually-hidden">{copy.caption}</figcaption>
  </figure>
</section>
