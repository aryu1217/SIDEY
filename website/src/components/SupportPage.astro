---
import PolicyLayout from "../layouts/PolicyLayout.astro";
import { getWebsiteCopy, localePathSegment, type Locale } from "../i18n/landing";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const path = localePathSegment(locale);
const supportEmail = "ryu200112@gmail.com";
const issuesUrl = "https://github.com/sidey-app/SIDEY/issues";
const bugReportUrl = "https://github.com/sidey-app/SIDEY/issues/new?template=01-bug-report.yml";
const macSystemCommand = "uname -mprs";
const windowsSystemCommand = "\"$([Environment]::OSVersion.VersionString) $(if ([Environment]::Is64BitOperatingSystem) { 'x64' } else { 'x86' })\"";
const macLogsCommand = 'log show --last 30m --style compact --predicate \'subsystem == "app.sidey.desktop"\' > ~/Desktop/SIDEY-Diagnostics-$(date +%Y%m%d-%H%M%S).log';
const copy = getWebsiteCopy(locale).support;
---

<PolicyLayout locale={locale} title={copy.title} description={copy.description} canonicalPath={`${path}/support/`} heading={copy.heading} introduction={copy.introduction} current="support">
  <article class="policy-markdown">
    <h2>{copy.githubTitle}</h2>
    <p>{copy.githubBody}</p>
    <ul>
      <li><a href={`${issuesUrl}?q=is%3Aissue`}>{copy.searchIssues}</a></li>
      <li><a href={bugReportUrl}>{copy.reportIssue}</a></li>
    </ul>
    <h2>{copy.emailTitle}</h2>
    <p>{copy.emailBody}</p>
    <p><a href={`mailto:${supportEmail}`}>{copy.emailAction}: {supportEmail}</a></p>
    <h2>{copy.include}</h2>
    <ul>{copy.details.map((detail) => <li>{detail}</li>)}</ul>
    <h2>{copy.diagnostics}</h2>
    <h3>{copy.operatingSystem}</h3>
    <p>{copy.macosLabel}</p>
    <pre dir="ltr"><code>{macSystemCommand}</code></pre>
    <p>{copy.windowsLabel}</p>
    <pre dir="ltr"><code>{windowsSystemCommand}</code></pre>
    <p>{copy.macVersion}</p>
    <p>{copy.windowsVersion}</p>
    <p>{copy.macDiagnostics}</p>
    <pre dir="ltr"><code>{macLogsCommand}</code></pre>
    <p>{copy.windowsDiagnostics}</p>
    <h2>{copy.protect}</h2>
    <p>{copy.protectBody}</p>
    <p>{copy.response}</p>
  </article>
</PolicyLayout>

<style>
  pre {
    max-width: 100%;
    overflow-x: auto;
    white-space: pre;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--surface-secondary, rgba(127, 127, 127, 0.1));
  }
  code { font-family: monospace; }
</style>
