---
import { getTranslations, localePathSegment, localeRoot, type Locale } from "../i18n/landing";

interface Props {
  locale?: Locale;
  current?: "home" | "store" | "whats-new" | "support";
  rootPath?: string;
  homeHref?: string;
}

const {
  locale = "ko",
  current,
  homeHref,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const localizedHome = homeHref ?? localeRoot(locale);
const labels = getTranslations(locale).navigation;
const localePrefix = `${localePathSegment(locale)}/`;
const featuresHref = `${localizedHome}#features`;
const downloadHref = `${localizedHome}#download`;
const faqHref = `${localizedHome}#faq`;
const whatsNewHref = `${base}${localePrefix}whats-new/`;
const storeHref = `${base}${localePrefix}store/`;
const supportHref = `${base}${localePrefix}support/`;
---

<header class="site-header site-header-unified" data-site-header>
  <nav class="nav-shell" aria-label={labels.navigation}>
    <a class="brand-link" href={localizedHome} aria-label={labels.home}>
      <img src={`${base}assets/app-icon.png`} alt="" width="32" height="32">
      <span>SIDEY</span>
    </a>
    <ul class="nav-links" id="site-navigation-links" data-nav-menu>
      <li><a href={featuresHref} data-nav-section="features">{labels.features}</a></li>
      <li><a href={downloadHref} data-nav-section="download">{labels.download}</a></li>
      <li><a href={faqHref} data-nav-section="faq">{labels.faq}</a></li>
      <li class="nav-separator" aria-hidden="true"></li>
      <li><a href={whatsNewHref} aria-current={current === "whats-new" ? "page" : undefined}>{labels.whatsNew}</a></li>
      <li><a href={storeHref} aria-current={current === "store" ? "page" : undefined}>{labels.store}</a></li>
      <li><a href={supportHref} aria-current={current === "support" ? "page" : undefined}>{labels.support}</a></li>
    </ul>
    <div class="nav-controls">
      <span class="nav-controls-separator" aria-hidden="true"></span>
      <button class="theme-toggle" type="button" aria-label={labels.useDarkTheme} data-theme-toggle data-light-label={labels.useLightTheme} data-dark-label={labels.useDarkTheme}>
        <span class="material-symbols-rounded" aria-hidden="true" data-theme-icon>dark_mode</span>
      </button>
      <button class="nav-menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation-links" aria-label={labels.openMenu} data-nav-menu-toggle data-open-label={labels.openMenu} data-close-label={labels.closeMenu}>
        <span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </nav>
  <slot />
</header>

<script src={`${import.meta.env.BASE_URL}assets/site-header.js`} defer is:inline></script>
