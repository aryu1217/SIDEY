---
import { localeRoot, supportedLocales, localeNames } from "../i18n/landing";
interface Props { path?: string; title?: string; }
const { path = "", title = "SIDEY" } = Astro.props;
const suffix = path.replace(/^\/+|\/+$/g, "");
const routeSuffix = suffix ? `${suffix}/` : "";
const targets = Object.fromEntries(supportedLocales.map(code => [code.toLowerCase(), `${localeRoot(code)}${routeSuffix}`]));
const gatewayTarget = `${import.meta.env.BASE_URL}${routeSuffix}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="description" content="SIDEY language selection">
{supportedLocales.map(code => <link rel="alternate" hreflang={code} href={new URL(targets[code.toLowerCase()], Astro.site)} />)}
<link rel="alternate" hreflang="x-default" href={new URL(gatewayTarget, Astro.site)}>
<script is:inline define:vars={{ targets }}>
(() => {
 const match = value => {
   const tag = (value ?? "").toLowerCase();
   if (targets[tag]) return tag;
   if (tag.startsWith("zh-hans")) return "zh-hans";
   if (tag.startsWith("zh-hant")) return "zh-hant";
   if (tag.startsWith("zh")) return /tw|hk|mo/.test(tag) ? "zh-hant" : "zh-hans";
   if (tag.startsWith("pt")) return tag.includes("br") ? "pt-br" : "pt-pt";
   if (tag.startsWith("sr")) return tag.includes("latn") ? "sr-latn" : "sr-cyrl";
   if (tag === "iw" || tag.startsWith("iw-")) return "he";
   const primary = tag.split("-")[0];
   return targets[primary] ? primary : undefined;
 };
 const language = (navigator.languages?.length ? navigator.languages : [navigator.language]).map(match).find(Boolean) ?? "en";
 const target = new URL(targets[language], window.location.origin);
 target.search = window.location.search; target.hash = window.location.hash;
 window.location.replace(target.href);
})();
</script>
</head>
<body><main><nav aria-label="Choose language">{supportedLocales.map(code => <a href={targets[code.toLowerCase()]} lang={code} hreflang={code}>{localeNames[code]}</a>)}</nav></main></body>
</html>

<style>
  nav { display: flex; flex-wrap: wrap; gap: 1rem; padding: 1rem; }
</style>
