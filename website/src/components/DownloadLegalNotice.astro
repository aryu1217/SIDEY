---
import { getWebsiteCopy, localePathSegment, type Locale } from "../i18n/landing";

interface Props {
  id: string;
  locale: Locale;
}

const { id, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const localePath = localePathSegment(locale);
const termsHref = `${base}${localePath}/terms/`;
const privacyHref = `${base}${localePath}/privacy/`;
const copy = getWebsiteCopy(locale);
const parts = copy.legalNotice.split(/(\{terms\}|\{privacy\})/);
---

<span class="download-license-tooltip" id={id} role="note">
  {parts.map(part => part === "{terms}" ? <a href={termsHref}>{copy.footer.terms}</a> : part === "{privacy}" ? <a href={privacyHref}>{copy.footer.privacy}</a> : part)}
</span>
