---
import StoreLayout from "../layouts/StoreLayout.astro";
import PageTabs from "./PageTabs.astro";
import type { StoreCategory, StoreProduct } from "../data/store";
import { getStoreCategories } from "../data/store";
import { getWebsiteCopy, localePathSegment, type Locale } from "../i18n/landing";

interface Props { category: StoreCategory; locale?: Locale; canonicalPath?: string; }
const { category, locale = "ko", canonicalPath } = Astro.props;
const content = getStoreCategories(locale)[category];
const detailProducts = [...content.products, ...content.products.flatMap((product) => product.keepsake ? [product.keepsake] : [])];
const base = import.meta.env.BASE_URL;
const localePrefix = `${localePathSegment(locale)}/`;
const storeBase = `${base}${localePrefix}store/`;
const chrome = getWebsiteCopy(locale).storeChrome;
const previewAttributes = (product: StoreProduct) => ({
  "data-store-preview": true,
  "data-product-id": product.commerceID ?? product.id,
  "data-preview-kind": product.mode === "character" ? "character" : product.mode === "bubble" ? "bubble" : "throwable",
  "data-preview-mode": product.mode,
  "data-preview-src": product.previewAsset || product.asset ? `${base}${product.previewAsset ?? product.asset}` : undefined,
  "data-preview-emitter": product.emitterAsset ? `${base}${product.emitterAsset}` : undefined,
  "data-preview-decoration": product.bubbleTheme && product.asset ? `${base}${product.asset}` : undefined,
  "data-preview-theme": product.bubbleTheme,
  "data-preview-mirrors": product.mirrorsMovement ? "true" : undefined,
  "data-preview-title": product.name,
  "data-preview-description": product.description + (product.isTree ? ` ${chrome.treeHint}` : ""),
  "data-preview-message": chrome.bubbleMessage,
  "data-preview-sound": product.sound ? `${base}${product.sound}` : undefined,
  "data-preview-stretch": product.id === "throwable_dujjonku" ? "true" : undefined,
  "data-preview-details": `details-${product.id}`,
  "aria-label": `${product.name} ${chrome.preview}`,
});
const tabs = [
  { href: `${storeBase}characters/`, label: chrome.characters, active: category === "characters" },
  { href: `${storeBase}bubbles/`, label: chrome.bubbles, active: category === "bubbles" },
  { href: `${storeBase}throwables/`, label: chrome.throwables, active: category === "throwables" },
];
---

<StoreLayout locale={locale} title={`${content.eyebrow} · ${chrome.store}`} description={content.description} canonicalPath={canonicalPath ?? `${localePrefix}store/${category}/`}>
  <section class="section store-intro store-catalog-page" aria-labelledby="store-title">
    <h1 id="store-title">{content.title}</h1>
    <p class="store-description">{content.description}</p>
    <PageTabs label={chrome.categories} items={tabs} />

    <div class="store-product-grid">
      {content.products.map((product) => (
        <button class="store-product-card" type="button" {...previewAttributes(product)}>
          <span class={`store-product-media store-product-media-${product.mode}${product.bubbleTheme === "default" ? " is-loaded" : ""}`}>
            <span class="store-media-skeleton" aria-hidden="true"></span>
            {product.bubbleTheme ? (
              <span class="store-bubble-scene" aria-hidden="true">
                <span class={`store-bubble-wrap store-bubble-wrap-${product.bubbleTheme}`}>
                  <span class={`store-bubble store-bubble-${product.bubbleTheme}`}>
                    <span>{chrome.bubbleMessage}</span>
                  </span>
                  {product.asset && <img class="store-product-image store-bubble-decoration" src={`${base}${product.asset}`} alt="" loading="lazy" decoding="async">}
                </span>
                <span class="store-bubble-actor"><img src={`${base}assets/characters/pixel_hamster.png`} alt="" loading="lazy" decoding="async"></span>
              </span>
            ) : (
              product.asset && <span class="store-product-art"><img class="store-product-image" src={`${base}${product.asset}`} alt="" loading="lazy" decoding="async"></span>
            )}
          </span>
          <span class="store-product-copy"><strong>{product.name}</strong><span>{product.description}</span>
            {product.isTree && <span>{chrome.treeHint}</span>}
            {product.isKeepsake && <span class="store-keepsake-badge">{chrome.keepsake} · {chrome.separate}</span>}
          </span>
          <span class="store-product-meta"><strong>{product.price}</strong><span>{chrome.previewAction}</span></span>
          {product.keepsake && <span class="store-keepsake-summary">
            <span class="store-keepsake-badge">{chrome.keepsake} · {chrome.separate}</span>
            <span>{product.keepsake.name}</span><strong>{product.keepsake.price}</strong>
          </span>}
        </button>
      ))}
    </div>
  </section>

  {detailProducts.map((product) => <template id={`details-${product.id}`}>
    <div class:list={["store-preview-products", { "has-keepsake": Boolean(product.keepsake) }]}>
      <div class="store-preview-product">
        <span class="store-detail-label">{product.mode === "character" ? chrome.characters : product.isKeepsake ? chrome.keepsake : content.eyebrow}</span>
        <strong>{product.name}</strong><span>{product.price}</span>
      </div>
      {product.keepsake && <button type="button" class="store-preview-product store-preview-keepsake" {...previewAttributes(product.keepsake)}>
        <span class="store-keepsake-badge">{chrome.keepsake} · {chrome.separate}</span>
        <span class="store-keepsake-art"><img src={`${base}${product.keepsake.asset}`} alt="" loading="lazy" /></span>
        <strong>{product.keepsake.name}</strong><span>{product.keepsake.price}</span>
        <span class="store-detail-description">{product.keepsake.description}</span>
      </button>}
    </div>
  </template>)}

  <dialog class="store-preview-dialog" id="store-preview-dialog" aria-labelledby="store-preview-title">
    <button class="store-preview-close" type="button" data-store-preview-close aria-label={chrome.closePreview}><span class="material-symbols-rounded" aria-hidden="true">close</span></button>
    <div class="store-preview-stage-wrap">
      <div class="store-preview-stage" data-store-preview-stage aria-hidden="true"></div>
      <button class="store-preview-sound" type="button" data-store-preview-sound-toggle aria-pressed="false" hidden>
        <svg class="store-sound-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M11 4 5 9H2v6h3l6 5V4Z" />
          <g class="store-sound-waves"><path d="M15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14" /></g>
          <g class="store-sound-mute"><path d="m16 9 6 6m0-6-6 6" /></g>
        </svg><span>{chrome.sound}</span>
      </button>
    </div>
    <div class="store-preview-copy"><h2 id="store-preview-title" data-store-preview-title></h2><p data-store-preview-description></p></div>
    <div data-store-preview-details></div>
  </dialog>
</StoreLayout>
