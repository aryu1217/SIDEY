---
import { getWebsiteCopy, localePathSegment, type Locale } from "../i18n/landing";
import LanguageLinks from "./LanguageLinks.astro";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = localePathSegment(locale);

const content: Record<string, {
  commerceAria: string; delivery: string; deliveryBody: string; refund: string; refundBody: string; refundLink: string;
  businessName: string; registration: string; contact: string; address: string; addressValue: string;
  representative: string; onlineSalesRegistration: string; onlineSalesValue: string;
  links: { href: string; label: string }[];
}> = {
  ko: {
    commerceAria: "배송 및 교환·환불 안내", delivery: "배송일자", deliveryBody: "디지털 상품으로 결제 완료 즉시 사용 가능",
    refund: "교환·환불", refundBody: "결제 확인과 동시에 사용권 제공이 시작되어 단순 변심에 따른 환불은 불가합니다. 다만 미제공·계약 불일치·중복 또는 무단 결제 등 관련 법령상 사유가 확인되면 전액 환불합니다.", refundLink: "자세한 규정",
    businessName: "상호명", registration: "사업자등록번호", contact: "연락처", address: "사업장 주소", addressValue: "경기도 용인시 기흥구 서천동로21번길 20-6",
    representative: "대표자명", onlineSalesRegistration: "통신판매업 신고번호", onlineSalesValue: "신고 면제(간이과세자)",
    links: [{ href: "terms/", label: "이용약관" }, { href: "privacy/", label: "개인정보 처리방침" }, { href: "refund/", label: "청약철회 및 환불 정책" }],
  },

};
const copy = content.ko;
const labels = getWebsiteCopy(locale).footer;
const links = [{href:"terms/", label:labels.terms},{href:"privacy/",label:labels.privacy},{href:"refund/",label:labels.refund}];
---

<footer class="site-footer">
  {locale === "ko" && <>
  <div class="footer-commerce-policy" aria-label={copy.commerceAria}>
    <p><strong>{copy.delivery}</strong><span>{copy.deliveryBody}</span></p>
    <p><strong>{copy.refund}</strong><span>{copy.refundBody} <a href={`${base}${path}/refund/`}>{copy.refundLink}</a></span></p>
  </div>
  <dl class="footer-details footer-details-business">
    <div><dt>{copy.businessName}</dt><dd><span lang="ko">싸이디</span>(SIDEY)</dd></div>
    <div><dt>{copy.registration}</dt><dd>388-53-01259</dd></div>
    <div><dt>{copy.contact}</dt><dd><a href="tel:+821092702973">010-9270-2973</a> · <a href="mailto:ryu200112@gmail.com">ryu200112@gmail.com</a></dd></div>
    <div><dt>{copy.address}</dt><dd>{copy.addressValue}</dd></div>
    <div><dt>{copy.representative}</dt><dd><span lang="ko">류태현</span></dd></div>
    <div><dt>{copy.onlineSalesRegistration}</dt><dd>{copy.onlineSalesValue}</dd></div>
  </dl>
  </>}
  <div class="footer-row">
    <div class="footer-brand"><img src={`${base}assets/app-icon.png`} alt="" width="36" height="36"><strong>SIDEY</strong></div>
    <div class="footer-links">
      {links.map((link) => <a href={`${base}${path}/${link.href}`}>{link.label}</a>)}
    </div>
  </div>
  <LanguageLinks locale={locale} />
</footer>
