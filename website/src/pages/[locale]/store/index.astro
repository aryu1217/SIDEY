---
import StoreCatalogPage from "../../../components/StoreCatalogPage.astro";
import { supportedLocales, localePathSegment, type Locale } from "../../../i18n/landing";

export function getStaticPaths() {
  return supportedLocales.filter((locale) => !["ko", "en", "ja", "zh-Hant"].includes(locale))
    .map((locale) => ({ params: { locale: localePathSegment(locale) }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<StoreCatalogPage locale={locale} category="characters" canonicalPath={`${localePathSegment(locale)}/store/`} />
